{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "AI": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.6-flash",
    "CapacityMode": "Limited",
    "TimeoutSeconds": 30,
    "MaxConcurrentRequests": 1,
    "MaxRetries": 1,
    "MaxRetryDelaySeconds": 5,
    "DailyQuotaAware": true
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-mini"
  },
  "Knowledge": {
    "RootPath": "./knowledge/raw",
    "ChunkTargetCharacters": 1800,
    "ChunkOverlapCharacters": 180,
    "FallbackExtraction": {
      "Provider": "GeminiThenLocalOcr",
      "Model": "gemini-3.6-flash",
      "PipelineVersion": "vision-pdf-v1",
      "CachePath": "./knowledge/cache/fallback",
      "PagesPerRequest": 4,
      "MaxConcurrentPages": 2,
      "RetryCount": 3
    }
  },
  "Embedding": {
    "Provider": "Gemini",
    "Model": "gemini-embedding-001",
    "Dimensions": 768,
    "BatchSize": 20
  },
  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "VerifyToken": "",
    "AppSecret": "",
    "GraphApiVersion": "v21.0"
  },
  "Storage": {
    "ConnectionString": "",
    "ContainerName": "led-sup-bot-media"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "WhatsAppConnector": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:3100",
    "SharedSecret": ""
  },
  "MediaStorage": {
    "RootPath": "./data/media",
    "MaxFileSizeBytes": 10485760,
    "RetentionDays": 0
  },
  "Workflow": {
    "AutoReplyEnabled": true,
    "ConfigExampleImagePath": "",
    "NaturalTiming": {
      "Enabled": true,
      "GreetingMinSeconds": 1.5,
      "GreetingMaxSeconds": 3.5,
      "GreetingMaxChars": 60,
      "ShortMinSeconds": 2.5,
      "ShortMaxSeconds": 6,
      "ShortMaxChars": 120,
      "MediumMinSeconds": 4,
      "MediumMaxSeconds": 9,
      "MediumMaxChars": 280,
      "LongMinSeconds": 6,
      "LongMaxSeconds": 12,
      "MaxDelaySeconds": 15
    },
    "InboundCoalescing": {
      "Enabled": true,
      "WindowSeconds": 3
    }
  },
  "AiExtraction": {
    "ConfidenceThreshold": 0.85,
    "PreferDeterministicFirst": true
  },
  "TrainingCollection": {
    "FirstReviewThreshold": 200,
    "FirstTuningMin": 300,
    "FirstTuningTarget": 500
  },
  "WebGrounding": {
    "Enabled": true,
    "SearchOnlyWhenRequired": true,
    "MaxAttemptsPerTurn": 1,
    "TimeoutSeconds": 20,
    "PreferOfficialSources": true,
    "Provider": "GeminiGoogleSearch"
  },
  "PanelFilePackages": {
    "MaxFirmwareFileSizeBytes": 16777216,
    "MaxReceiverConfigFileSizeBytes": 8388608
  },
  "WhatsAppAutomation": {
    "ExcludedPhoneNumbers": []
  }
}
