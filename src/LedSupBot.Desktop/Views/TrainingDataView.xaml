<UserControl x:Class="LedSupBot.Desktop.Views.TrainingDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LedSupBot.Desktop.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EĞİTİM VERİLERİ"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold"
                               FontSize="15" />
                    <TextBlock Text="Operatör geri bildirimleri · yalnızca gelecekteki eğitim ve değerlendirme adayları"
                               Foreground="{StaticResource CardMutedBrush}"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="YENİLE"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshTrainingDataCommand}"
                        Padding="12,6"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="9" Margin="14,12,14,6">
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="TUNING-READY" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.TuningReady}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="İLK İNCELEME" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.ReviewProgressText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="DURUM" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.CollectionStatus}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrainingCounts.TuningRangeText, StringFormat=İlk tuning: {0}}" FontSize="10" Foreground="{StaticResource CardMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="ONAYLI" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.Approved}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="DÜZELTİLMİŞ" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.Edited}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="REDDEDİLMİŞ" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.Rejected}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="İNCELEME" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.NeedsReview}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="SFT ADAYI" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.EligibleForSft}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="3">
                <StackPanel>
                    <TextBlock Text="TERCİH ADAYI" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TrainingCounts.EligibleForPreference}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Margin="17,4,17,10"
                Padding="10">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Width="145" Margin="0,0,10,4">
                    <TextBlock Text="Durum" Style="{StaticResource CardLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding TrainingStatusOptions}"
                              SelectedItem="{Binding TrainingStatusFilter, Mode=TwoWay}"
                              MinHeight="28" />
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,10,4">
                    <TextBlock Text="Intent" Style="{StaticResource CardLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding TrainingIntentOptions}"
                              SelectedItem="{Binding TrainingIntentFilter, Mode=TwoWay}"
                              IsEditable="True"
                              MinHeight="28" />
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,10,4">
                    <TextBlock Text="Kaynak" Style="{StaticResource CardLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding TrainingSourceOptions}"
                              SelectedItem="{Binding TrainingSourceFilter, Mode=TwoWay}"
                              IsEditable="True"
                              MinHeight="28" />
                </StackPanel>

                <StackPanel Width="135" Margin="0,0,10,4">
                    <TextBlock Text="Başlangıç tarihi" Style="{StaticResource CardLabel}" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding TrainingDateFrom, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                MinHeight="28" />
                </StackPanel>

                <StackPanel Width="135" Margin="0,0,10,4">
                    <TextBlock Text="Bitiş tarihi" Style="{StaticResource CardLabel}" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding TrainingDateTo, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                MinHeight="28" />
                </StackPanel>

                <Button Content="FİLTRELE"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshTrainingDataCommand}"
                        Padding="14,6"
                        Margin="0,17,0,4"
                        VerticalAlignment="Bottom" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3" Margin="17,0,17,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="ADAYLAR" Style="{StaticResource SectionTitle}" Margin="0" />
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding TrainingExamples}"
                             SelectedItem="{Binding SelectedTrainingExample}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,6">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OriginalAiResponse}"
                                               Foreground="{StaticResource CardMutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                               Foreground="{StaticResource SectionHeaderBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <TextBlock Text="Henüz eşleşen eğitim adayı yok."
                               Style="{StaticResource EmptyStateText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasTrainingExamples, Converter={StaticResource InverseBoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="16"
                                  Visibility="{Binding HasTrainingExamples, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedTrainingExample}">
                            <TextBlock Text="EĞİTİM ADAYI DETAYI" Style="{StaticResource SectionTitle}" FontSize="12" />

                            <UniformGrid Columns="4" Margin="0,8,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Geri bildirim" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding FeedbackStatus}" Style="{StaticResource CardValue}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Uygunluk" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding TrainingEligibility}" Style="{StaticResource CardValue}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Intent" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding CurrentIntent}" Style="{StaticResource CardValue}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Kaynak kararı" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding SourceDecision}" Style="{StaticResource CardValue}" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="MÜŞTERİ MESAJI" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding OriginalCustomerMessage}"
                                       Style="{StaticResource IssueBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,12" />

                            <TextBlock Text="ORİJİNAL AI YANITI" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding OriginalAiResponse}"
                                       Style="{StaticResource IssueBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,12" />

                            <TextBlock Text="TERCİH EDİLEN YANIT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PreferredTechnicianResponse, TargetNullValue=—}"
                                       Style="{StaticResource IssueBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nedenler" Style="{StaticResource CardLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReasonTagsText}" Style="{StaticResource CardValue}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="RAG kullanıldı" Style="{StaticResource CardLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RagUsedText}" Style="{StaticResource CardValue}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Grounding" Style="{StaticResource CardLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GroundingLevel, TargetNullValue=—}" Style="{StaticResource CardValue}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Model" Style="{StaticResource CardLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeminiModel, TargetNullValue=—}" Style="{StaticResource CardValue}" />
                            </Grid>

                            <TextBlock Text="TANI BAĞLAMI" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding DiagnosticContextSummary, TargetNullValue=—}"
                                       Style="{StaticResource IssueBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.ColumnSpan="3"
                       Text="Eğitim verileri yükleniyor…"
                       Style="{StaticResource EmptyStateText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsLoadingTrainingData, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
