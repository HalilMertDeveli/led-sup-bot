<Window x:Class="LedSupBot.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Support Başlatılıyor"
        Width="380"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource HeaderBgBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28">
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <!-- Brand Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="LED SUPPORT" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <TextBlock Text="Servisler ve bağlantılar kontrol ediliyor..."
                           Foreground="{StaticResource CardMutedBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- Console Status Lines -->
                <Border Background="#151C28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding PostgreSqlLine}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource CardTextBrush}" Margin="0,3" />
                        <TextBlock Text="{Binding ApiLine}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource CardTextBrush}" Margin="0,3" />
                        <TextBlock Text="{Binding ConnectorLine}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource CardTextBrush}" Margin="0,3" />
                        <TextBlock Text="{Binding WhatsAppLine}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource CardTextBrush}" Margin="0,3" />
                    </StackPanel>
                </Border>

                <!-- Overall Status Text -->
                <TextBlock Text="{Binding StatusText}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
