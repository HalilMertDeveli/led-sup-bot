<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shell Base Colors -->
    <Color x:Key="BgColor">#0B0E14</Color>
    <Color x:Key="HeaderBgColor">#111622</Color>
    <Color x:Key="SidebarBgColor">#151B26</Color>
    <Color x:Key="ChatBgColor">#12161F</Color>
    <Color x:Key="PanelBgColor">#151B26</Color>

    <!-- Surfaces & Cards -->
    <Color x:Key="SurfaceColor">#1B2230</Color>
    <Color x:Key="SurfaceHoverColor">#232C3E</Color>
    <Color x:Key="SurfaceSelectedColor">#263247</Color>
    <Color x:Key="BorderColor">#263143</Color>
    <Color x:Key="BorderStrongColor">#37445C</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="SectionHeaderColor">#7E95B3</Color>

    <!-- Semantics -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="WarnHoverColor">#D97706</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerHoverColor">#DC2626</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="InfoHoverColor">#0284C7</Color>
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryHoverColor">#2563EB</Color>

    <!-- Badges Backgrounds -->
    <Color x:Key="BadgeSuccessBgColor">#133829</Color>
    <Color x:Key="BadgeWarnBgColor">#382A14</Color>
    <Color x:Key="BadgeDangerBgColor">#381818</Color>
    <Color x:Key="BadgeInfoBgColor">#132D42</Color>

    <!-- Message Bubbles -->
    <Color x:Key="MsgInboundBgColor">#1C2432</Color>
    <Color x:Key="MsgInboundBorderColor">#283448</Color>
    <Color x:Key="MsgInboundSenderColor">#38BDF8</Color>

    <Color x:Key="MsgOutboundBgColor">#0D3E31</Color>
    <Color x:Key="MsgOutboundBorderColor">#145543</Color>
    <Color x:Key="MsgOutboundSenderColor">#34D399</Color>

    <!-- Buttons -->
    <Color x:Key="BtnSecondaryColor">#252F40</Color>
    <Color x:Key="BtnSecondaryHoverColor">#323F55</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="ChatBgBrush" Color="{StaticResource ChatBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="CardTextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="CardMutedBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{StaticResource SectionHeaderColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnHoverBrush" Color="{StaticResource WarnHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoHoverBrush" Color="{StaticResource InfoHoverColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SuccessColor}" />

    <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="{StaticResource BadgeSuccessBgColor}" />
    <SolidColorBrush x:Key="BadgeWarnBgBrush" Color="{StaticResource BadgeWarnBgColor}" />
    <SolidColorBrush x:Key="BadgeDangerBgBrush" Color="{StaticResource BadgeDangerBgColor}" />
    <SolidColorBrush x:Key="BadgeInfoBgBrush" Color="{StaticResource BadgeInfoBgColor}" />

    <SolidColorBrush x:Key="MsgInboundBgBrush" Color="{StaticResource MsgInboundBgColor}" />
    <SolidColorBrush x:Key="MsgInboundBorderBrush" Color="{StaticResource MsgInboundBorderColor}" />
    <SolidColorBrush x:Key="MsgInboundSenderBrush" Color="{StaticResource MsgInboundSenderColor}" />

    <SolidColorBrush x:Key="MsgOutboundBgBrush" Color="{StaticResource MsgOutboundBgColor}" />
    <SolidColorBrush x:Key="MsgOutboundBorderBrush" Color="{StaticResource MsgOutboundBorderColor}" />
    <SolidColorBrush x:Key="MsgOutboundSenderBrush" Color="{StaticResource MsgOutboundSenderColor}" />

    <SolidColorBrush x:Key="BtnPrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BtnPrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="BtnSuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="BtnSuccessHoverBrush" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="BtnDestructiveBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="BtnDestructiveHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="BtnSecondaryBrush" Color="{StaticResource BtnSecondaryColor}" />
    <SolidColorBrush x:Key="BtnSecondaryHoverBrush" Color="{StaticResource BtnSecondaryHoverColor}" />

    <!-- Window Baseline -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Modern Thin ScrollBar Styles -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="3"
                            Background="#3E4C63"
                            Opacity="0.75"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinWidth" Value="7"/>
        <Setter Property="Width" Value="7"/>
        <Setter Property="MinHeight" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cards & Containers -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="SectionHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="#171E2B" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SectionHeaderBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CardTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="IssueBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CardTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- Modern Buttons -->
    <Style x:Key="ActionButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnPrimaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnSuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnSuccessHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnDestructiveBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnDestructiveHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnSecondaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CardTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnSecondaryHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <!-- Modern Dark Input Boxes with Watermark Support -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#171E2A" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource CardMutedBrush}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="#1A2230" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Filter Tabs (Segmented Control Button) -->
    <Style x:Key="FilterTabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Modern ListBox / ListBoxItem -->
    <Style x:Key="ConversationListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style x:Key="ConversationListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="10,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter Modern Style -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" Width="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
