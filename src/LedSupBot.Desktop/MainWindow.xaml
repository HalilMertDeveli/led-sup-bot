<Window x:Class="LedSupBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LedSupBot.Desktop.Converters"
        Title="LED Support"
        Width="420"
        Height="720"
        MinWidth="380"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:RoleLabelConverter x:Key="RoleLabel" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <conv:ConnectionBrushConverter x:Key="ConnBrush" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Login overlay -->
        <Border Grid.RowSpan="7"
                Background="#CC1A1D21"
                Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <TextBlock Text="LED Support" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Operator girişi" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <PasswordBox x:Name="PasswordBox" Padding="10,8" Margin="0,0,0,8"
                             PasswordChanged="PasswordBox_OnPasswordChanged" />
                <Button Content="Giriş" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                        Command="{Binding LoginCommand}" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
            </StackPanel>
        </Border>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="LED SUPPORT" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Status row -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="WhatsApp" Width="90" Foreground="{StaticResource MutedBrush}" />
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding WhatsAppConnected, Converter={StaticResource ConnBrush}}" />
                    <TextBlock Text="{Binding WhatsAppStatus}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bot" Width="90" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding BotStatusText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Primary bot control -->
        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}" />

        <!-- AnyDesk alert -->
        <Border Grid.Row="3" Background="#332A1A" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,10"
                Visibility="{Binding ShowAnyDeskAlert, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="⚠ MÜŞTERİ ANYDESK AŞAMASINDA" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ekran" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScreenSummary}" />
                    <TextBlock Grid.Row="1" Text="Receiver" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverSummary}" />
                    <TextBlock Grid.Row="2" Text="Panel" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PanelStatus}" />
                    <TextBlock Grid.Row="3" Text="Config" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfigStatus}" />
                    <TextBlock Grid.Row="4" Text="AnyDesk" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AnyDeskStatus}" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="KONUŞMAYI DEVRAL" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding TakeOverCommand}" />
                    <Button Content="BOT DEVAM ETSİN" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DismissAnyDeskCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Active customer + technical summary -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="AKTİF MÜŞTERİ" />
                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="Aşama" Margin="0,8,0,0" />
                <TextBlock Text="{Binding StageLabel}" Margin="0,0,0,8" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="Sorun" />
                <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="TEKNİK ÖZET" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ekran" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScreenSummary}" />
                    <TextBlock Grid.Row="1" Text="Receiver" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverSummary}" />
                    <TextBlock Grid.Row="2" Text="Panel" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PanelStatus}" />
                    <TextBlock Grid.Row="3" Text="Config" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfigStatus}" />
                    <TextBlock Grid.Row="4" Text="AnyDesk" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AnyDeskStatus}" />
                    <TextBlock Grid.Row="5" Text="Medya" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PhotoCountText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Recent messages -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="SON MESAJLAR" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                        <Run Text="{Binding Role, Converter={StaticResource RoleLabel}}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Takeover -->
        <Button Grid.Row="6" Style="{StaticResource SecondaryButton}" Content="KONUŞMAYI DEVRAL"
                Command="{Binding TakeOverCommand}"
                Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVis}}" />

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="#F07178" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
    </Grid>
</Window>
