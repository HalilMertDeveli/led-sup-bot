# Placeholder values only — copy to .env for local reference (gitignored).
# The ASP.NET API reads process environment variables, not a .env file on disk.
# Set these in your shell before running the API (see README "Setup on a New Computer").

# Local docker-compose default (see docker-compose.yml):
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=led_sup_bot;Username=postgres;Password=your-local-postgres-password

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_GRAPH_API_VERSION=v21.0

# Unofficial Baileys connector (Phase 4.5) — NOT Meta-approved
# Shared secret MUST match connector/.env CONNECTOR_SHARED_SECRET (same value, never commit).
WHATSAPP_CONNECTOR_ENABLED=false
WHATSAPP_CONNECTOR_BASE_URL=http://127.0.0.1:3100
WHATSAPP_CONNECTOR_SHARED_SECRET=your-local-shared-secret
# Alias also accepted by API if WHATSAPP_CONNECTOR_SHARED_SECRET is unset:
# CONNECTOR_SHARED_SECRET=your-local-shared-secret

STORAGE_CONNECTION_STRING=your-storage-connection-string
STORAGE_CONTAINER_NAME=led-sup-bot-media

# Phase 5 workflow — keep AutoReplyEnabled=false on live personal WhatsApp until verified
WORKFLOW_AUTO_REPLY_ENABLED=false
WORKFLOW_CONFIG_EXAMPLE_IMAGE_PATH=

# Admin (Vite) — used when running admin/ (see admin/.env.example)
VITE_API_BASE_URL=http://localhost:5080

ASPNETCORE_ENVIRONMENT=Development
