# Placeholder values only — copy to .env and fill locally. Never commit real secrets.
# copy .env.example .env

PORT=3100

# Must equal ASP.NET WHATSAPP_CONNECTOR_SHARED_SECRET (same value in both processes).
# Either name works in the connector; set both to the same local value.
CONNECTOR_SHARED_SECRET=your-local-shared-secret
WHATSAPP_CONNECTOR_SHARED_SECRET=your-local-shared-secret

ASPNET_WEBHOOK_URL=http://127.0.0.1:5080/internal/whatsapp/events
SESSION_DIR=.sessions
LOG_LEVEL=info
